# Klaviyo private API key (from your Klaviyo account → Settings → API Keys)
KLAVIYO_PRIVATE_API_KEY=pk_your_key_here

# HubSpot account service key (from HubSpot Developer → Account Service Keys)
HUBSPOT_SERVICE_KEY=your_key_here

# Shared secret for the live demo endpoint — sent as X-Demo-Key header from the UI
# Set in Render env vars for production; omit locally to skip auth check
DEMO_SECRET=
